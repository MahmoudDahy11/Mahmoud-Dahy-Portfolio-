# Secrets for the `contact-notify` Edge Function, which emails you when the public contact
# form receives a message.
#
# Copy this file to `supabase/functions/.env` (git-ignored) for local development, and push
# the same values to the hosted project with:
#
#   supabase secrets set --env-file supabase/functions/.env
#
# None of these are ever read by the browser. They live only in the Edge Function's
# environment, so they can be real credentials without becoming public ones.

# Resend API key — https://resend.com → API Keys. Starts with `re_`.
RESEND_API_KEY=

# The inbox that receives every contact message.
CONTACT_NOTIFY_EMAIL=

# Sender address. `onboarding@resend.dev` is Resend's test sender and only delivers to the
# address on your Resend account; add and verify your own domain in Resend, then replace
# this with e.g. `Your Name <hello@yourdomain.com>`.
CONTACT_FROM_EMAIL="Portfolio Contact <onboarding@resend.dev>"
