# Supabase project configuration.
#
# Copy this file to `.env` and fill in the real values. `.env` is git-ignored, so it is
# never committed.
#
# VITE_SUPABASE_ANON_KEY is the *publishable* (anon) key. It is not a secret: it is
# bundled into the client and visible to every visitor. It is safe to ship because
# Supabase Row Level Security controls what it may do.
#
# Never put the service role key in this file or anywhere else in this repository. The
# service role bypasses RLS and would grant full database access to anyone who saw it.

VITE_SUPABASE_URL=https://utncrpncpehtscbuygvp.supabase.co
VITE_SUPABASE_ANON_KEY=

# Absolute URL of the deployed site. Used for canonical links, Open Graph tags, and the
# sitemap. Leave as http://localhost:5173 during development.
VITE_SITE_URL=http://localhost:5173
